# 只构建 Foreign 共库 Agent 进程，不启动旧文档 Worker 或独立存储服务。
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    FOREIGN_LITERATURE_ANALYSIS_CONCURRENCY=4
WORKDIR /app

COPY requirements.foreign.txt ./
RUN python -m pip install --no-cache-dir -r requirements.foreign.txt
# 在构建机器上提前检查 NumPy/Qdrant 的 CPU 与依赖兼容性。
RUN python -m pip check && python -c "import numpy; import qdrant_client; print('NumPy import OK:', numpy.__version__)"

COPY app ./app
RUN addgroup --system agent && adduser --system --ingroup agent agent
USER agent

EXPOSE 18000
CMD ["sh", "-c", "export OPENAI_API_KEY=\"${OPENAI_API_KEY:-$QWEN_API_KEY}\"; python -m app.foreign_integration.migrate && exec uvicorn app.foreign_integration.main:app --host 0.0.0.0 --port 18000"]
